# Database: use SQLite locally or a managed PostgreSQL URL in production.
DATABASE_URL=sqlite:///./recruitment.db

# Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173,https://your-project.vercel.app

# Keep true for a continuously running backend. Disable on serverless platforms.
ENABLE_SCHEDULER=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

IMAP_SERVER=
IMAP_PORT=993
EMAIL_ADDRESS=
EMAIL_PASSWORD=
MAILBOX=INBOX
